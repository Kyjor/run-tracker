# Copy to .ios-release.local.env and fill in your App Store Connect API credentials.
# The .p8 private key file must live at:
#   ~/.appstoreconnect/private_keys/AuthKey_<APP_STORE_API_KEY>.p8

APP_STORE_API_KEY=YOUR_KEY_ID
APP_STORE_API_ISSUER=YOUR_ISSUER_UUID

# Optional: override IPA path if autodetect fails
# IOS_IPA_PATH=src-tauri/gen/apple/build/arm64/Run With Friends.ipa
