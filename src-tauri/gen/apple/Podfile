target 'run-with-friends_iOS' do
  platform :ios, '15.0'
  pod 'Google-Mobile-Ads-SDK'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
    end
  end

  # Google-Mobile-Ads-SDK injects a global `-ObjC`. That force-loads every object in
  # Tauri's libapp.a. Official Tauri iOS plugins each vendor their own Tauri.swift, so
  # the flag turns latent duplicates into linker failures.
  #
  # Strip `-ObjC` only. Do NOT also -force_load GoogleMobileAds while still linking
  # `-framework GoogleMobileAds` — that double-links the static framework.
  # Banner APIs are referenced directly from Swift, so they still link without -ObjC.
  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', 'Pods-*', '*.xcconfig')).each do |path|
    text = File.read(path)
    next unless text.include?(' -ObjC')
    File.write(path, text.gsub(/ -ObjC\b/, ''))
    puts "[Podfile] stripped -ObjC from #{path}"
  end
end
