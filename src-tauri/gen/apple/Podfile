# Uncomment the next line to define a global platform for your project

target 'run-with-friends_iOS' do
platform :ios, '14.0'
  # Pods for run-with-friends_iOS
  pod 'Google-Mobile-Ads-SDK'
end

# Delete the deployment target for iOS, causing it to be inherited from the Podfile
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
    end
  end

  # Google-Mobile-Ads-SDK injects a global `-ObjC`, which force-loads every object in
  # Tauri's libapp.a. Official Tauri iOS plugins each vendor their own Tauri.swift, so
  # that flag turns latent duplicates into linker failures.
  # Replace it with -force_load for AdMob's static frameworks only.
  %w[debug release].each do |cfg|
    path = File.join(
      installer.sandbox.root,
      'Target Support Files',
      'Pods-run-with-friends_iOS',
      "Pods-run-with-friends_iOS.#{cfg}.xcconfig"
    )
    next unless File.exist?(path)

    text = File.read(path)
    text = text.gsub(/(OTHER_LDFLAGS = \$\(inherited\)) -ObjC/, '\1')
    force = [
      '-force_load $(PODS_XCFRAMEWORKS_BUILD_DIR)/Google-Mobile-Ads-SDK/GoogleMobileAds.framework/GoogleMobileAds',
      '-force_load $(PODS_XCFRAMEWORKS_BUILD_DIR)/GoogleUserMessagingPlatform/UserMessagingPlatform.framework/UserMessagingPlatform'
    ].join(' ')
    unless text.include?('force_load $(PODS_XCFRAMEWORKS_BUILD_DIR)/Google-Mobile-Ads-SDK')
      text = text.sub(
        /OTHER_LDFLAGS = \$\(inherited\)/,
        "OTHER_LDFLAGS = $(inherited) #{force}"
      )
    end
    File.write(path, text)
  end
end
